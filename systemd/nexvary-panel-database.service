[Unit]
Description=Nexvary Panel MariaDB Access Agent
After=network.target mariadb.service
Requires=mariadb.service
ConditionPathExists=/opt/nexvary-panel-agent/database_agent.py

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/nexvary-panel-agent
ExecStart=/usr/bin/python3 /opt/nexvary-panel-agent/database_agent.py
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/run/nexvary-panel

[Install]
WantedBy=multi-user.target
