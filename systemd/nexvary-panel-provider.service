[Unit]
Description=Nexvary Panel Fusion Provider Agent
After=network-online.target nexvary-panel-vault.service
Wants=network-online.target
Requires=nexvary-panel-vault.service
Before=nexvary-panel.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/nexvary-panel-agent/provider_agent.py
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadOnlyPaths=/etc/nexvary-panel/credentials /var/backups/nexvary-panel
ReadWritePaths=/run/nexvary-panel

[Install]
WantedBy=multi-user.target
