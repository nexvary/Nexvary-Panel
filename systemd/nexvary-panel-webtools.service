[Unit]
Description=Nexvary Panel Webtools Agent
After=network-online.target nginx.service
Wants=network-online.target
Before=nexvary-panel.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/bin/python3 /opt/nexvary-panel-agent/webtools_agent.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=-/etc/nginx/nexvary /etc/nginx/sites-available /var/www /run/nexvary-panel
ReadOnlyPaths=/var/log/nginx
UMask=0077

[Install]
WantedBy=multi-user.target
