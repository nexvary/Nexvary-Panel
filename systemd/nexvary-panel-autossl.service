[Unit]
Description=Nexvary Panel AutoSSL policy worker
After=nexvary-panel-ops.service
Requires=nexvary-panel-ops.service

[Service]
Type=oneshot
User=nexvary-panel
Group=nexvary-panel
Environment=NVP_DB_PATH=/var/lib/nexvary-panel/panel.db
Environment=NVP_OPS_SOCK=/run/nexvary-panel/ops.sock
ExecStart=/usr/bin/python3 /opt/nexvary-panel-agent/autossl_scheduler.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/var/lib/nexvary-panel /run/nexvary-panel
UMask=0077
