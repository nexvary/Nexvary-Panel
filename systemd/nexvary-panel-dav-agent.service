[Unit]
Description=Nexvary Panel CalDAV/CardDAV Provider Agent
After=network.target nexvary-panel-dav.service
Wants=nexvary-panel-dav.service
ConditionPathExists=/opt/nexvary-panel-agent/dav_agent.py

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/nexvary-panel-agent
ExecStart=/usr/bin/python3 /opt/nexvary-panel-agent/dav_agent.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/etc/nexvary-panel-radicale /run/nexvary-panel
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
